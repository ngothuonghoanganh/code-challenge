{
  "name": "problem5-crude-server",
  "version": "1.0.0",
  "private": true,
  "description": "Problem 5 TypeScript Express CRUD server",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "dev": "tsx watch index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/index.js",
    "test": "tsx --test tests/problem5.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  }
}
